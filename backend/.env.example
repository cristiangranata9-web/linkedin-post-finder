# Copia questo file in ".env" (che NON va mai committato/condiviso) oppure,
# meglio ancora, imposta questa variabile direttamente nel pannello "Secrets" /
# "Environment Variables" del tuo servizio di hosting (Render, Railway, Fly.io,
# un VPS con systemd, ecc.). Il backend la legge SOLO da variabile d'ambiente:
# non va mai scritta nel codice o nel frontend.

CRUSTDATA_API_KEY=la-tua-api-key-crustdata

# Opzionale: se impostata, il recupero dei POST LinkedIn (la parte che
# consuma più crediti Crustdata: 1 credito per post) viene fatto tramite
# Apify invece che Crustdata, per ridurre i costi. Il matching azienda ->
# pagina LinkedIn resta comunque su Crustdata (è gratuito). Crea un account
# su https://apify.com e prendi il token dalla sezione "Integrations" del
# tuo account.
APIFY_API_TOKEN=

# Richiesta SOLO dalla ricerca per tematica (Cluster MINIT): serve a
# classificare i post recuperati sulle "Aree Tematiche" del piano editoriale
# tramite l'API gratuita di Google Gemini. Non serve per la ricerca generale
# né per la ricerca per email. Chiave gratuita (nessuna carta di credito
# richiesta) su https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opzionale: limita il CORS al dominio del tuo frontend una volta pubblicato,
# invece di "*". Esempio: https://linkedin-post-finder.miodominio.it
FRONTEND_ORIGIN=*

# Opzionale: password condivisa richiesta a chi usa l'app (colleghi). Se
# lasciata vuota/non impostata, l'app resta accessibile senza password a
# chiunque abbia l'URL.
APP_PASSWORD=
