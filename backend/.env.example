# Copia questo file in ".env" (che NON va mai committato/condiviso) oppure,
# meglio ancora, imposta questa variabile direttamente nel pannello "Secrets" /
# "Environment Variables" del tuo servizio di hosting (Render, Railway, Fly.io,
# un VPS con systemd, ecc.). Il backend la legge SOLO da variabile d'ambiente:
# non va mai scritta nel codice o nel frontend.

CRUSTDATA_API_KEY=la-tua-api-key-crustdata

# Opzionale: limita il CORS al dominio del tuo frontend una volta pubblicato,
# invece di "*". Esempio: https://linkedin-post-finder.miodominio.it
FRONTEND_ORIGIN=*

# Opzionale: password condivisa richiesta a chi usa l'app (colleghi). Se
# lasciata vuota/non impostata, l'app resta accessibile senza password a
# chiunque abbia l'URL.
APP_PASSWORD=
